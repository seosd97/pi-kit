{
  "name": "@seosd/pi-kit",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "dependencies": {
    "@ff-labs/pi-fff": "^0.10.5",
    "@firstpick/pi-themes-bundle": "^0.1.6",
    "@juicesharp/rpiv-ask-user-question": "^2.7.1",
    "pi-background-tasks": "^2.4.2",
    "pi-lens": "^4.1.2",
    "pi-simplify": "^0.2.3",
    "pi-web-access": "^0.25.0"
  },
  "bundledDependencies": [
    "pi-web-access",
    "pi-lens",
    "@juicesharp/rpiv-ask-user-question",
    "@ff-labs/pi-fff",
    "pi-simplify",
    "pi-background-tasks",
    "@firstpick/pi-themes-bundle"
  ],
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/pi-web-access",
      "./node_modules/pi-lens",
      "./node_modules/@juicesharp/rpiv-ask-user-question",
      "./node_modules/@ff-labs/pi-fff",
      "./node_modules/pi-simplify",
      "./node_modules/pi-background-tasks"
    ],
    "skills": [
      "./skills",
      "./node_modules/pi-lens/skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes",
      "./node_modules/@firstpick/pi-themes-bundle/themes"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
