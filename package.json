{
  "name": "@seosd/pi-kit",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "update:packages": "pnpm update && pnpm sync:lock",
    "sync:lock": "npm install --package-lock-only --ignore-scripts"
  },
  "dependencies": {
    "@ff-labs/pi-fff": "^0.10.6",
    "@firstpick/pi-themes-bundle": "^0.1.6",
    "@juicesharp/rpiv-ask-user-question": "^2.9.0",
    "pi-background-tasks": "^2.5.0",
    "pi-lens": "^4.1.4",
    "pi-simplify": "^0.2.3",
    "pi-subagents": "^0.66.0",
    "pi-web-access": "^0.28.0"
  },
  "bundledDependencies": [
    "pi-web-access",
    "pi-lens",
    "@juicesharp/rpiv-ask-user-question",
    "@ff-labs/pi-fff",
    "pi-simplify",
    "pi-background-tasks",
    "@firstpick/pi-themes-bundle",
    "pi-subagents"
  ],
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/pi-web-access",
      "./node_modules/pi-lens",
      "./node_modules/@juicesharp/rpiv-ask-user-question",
      "./node_modules/@ff-labs/pi-fff",
      "./node_modules/pi-simplify",
      "./node_modules/pi-background-tasks",
      "./node_modules/pi-subagents"
    ],
    "skills": [
      "./skills",
      "./node_modules/pi-lens/skills",
      "./node_modules/pi-subagents/skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes",
      "./node_modules/@firstpick/pi-themes-bundle/themes"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "packageManager": "pnpm@11.23.0"
}
